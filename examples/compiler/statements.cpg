program : (function | statement)* ;
function : "fn" IDENT "(" parameters ")" block ;
parameters : (IDENT ("," IDENT)*)? ;
statement : declaration | assignment | output | conditional | loop | block | returning ;
returning : "return" expression? ";" ;
declaration : "let" IDENT ("=" expression)? ";" ;
assignment : IDENT "=" expression ";" ;
output : "print" expression ";" ;
conditional : "if" "(" expression ")" block ("else" block)? ;
loop : "while" "(" expression ")" block ;
block : "{" statement* "}" ;

expression : equality ;
equality : comparison (("==" | "!=") comparison)* ;
comparison : sum (("<" | "<=" | ">" | ">=") sum)* ;
sum : product (("+" | "-") product)* ;
product : unary ("*" unary)* ;
unary : ("+" | "-") unary | primary ;
primary : INTEGER | call | IDENT | "(" expression ")" ;
call : IDENT "(" arguments ")" ;
arguments : (expression ("," expression)*)? ;

IDENT = [a-zA-Z_][a-zA-Z0-9_]*
INTEGER = [0-9]+
SPACE = [ \t\r\n]+
@skip SPACE;
@keywords IDENT;
