program : (class_decl | function | statement)* ;
class_decl : "class" IDENT "{" (field | function | constructor)* "}" ;
field : "field" IDENT ":" IDENT ";" ;
function : "fn" IDENT "(" parameters ")" return_type block ;
return_type : (":" IDENT)? ;
constructor : "constructor" "(" parameters ")" block ;
parameters : (parameter ("," parameter)*)? ;
parameter : IDENT (":" IDENT)? ;
statement : typed_declaration | declaration | member_assignment | assignment | method_statement | output | conditional | loop | block | returning ;
typed_declaration : "let" IDENT ":" IDENT ("=" expression)? ";" ;
member_assignment : member "=" expression ";" ;
method_statement : method_call ";" ;
returning : "return" expression? ";" ;
declaration : "let" IDENT ("=" expression)? ";" ;
assignment : IDENT "=" expression ";" ;
output : "print" expression ";" ;
conditional : "if" "(" expression ")" block ("else" block)? ;
loop : "while" "(" expression ")" block ;
block : "{" statement* "}" ;

expression : equality ;
equality : comparison (("==" | "!=") comparison)* ;
comparison : sum (("<" | "<=" | ">" | ">=") sum)* ;
sum : product (("+" | "-") product)* ;
product : unary ("*" unary)* ;
unary : ("+" | "-") unary | primary ;
primary : INTEGER | boolean | construction | method_call | member | call | IDENT | "(" expression ")" ;
boolean : "true" | "false" ;
construction : "new" IDENT "(" arguments ")" ;
method_call : member "(" arguments ")" ;
member : IDENT ("." IDENT)+ ;
call : IDENT "(" arguments ")" ;
arguments : (expression ("," expression)*)? ;

IDENT = [a-zA-Z_][a-zA-Z0-9_]*
INTEGER = [0-9]+
SPACE = [ \t\r\n]+
@skip SPACE;
@keywords IDENT;
