class Counter {
    field value: int;
    field updates: int;
    fn init(start) {
        self.value = start;
        self.updates = 0;
        return self.value;
    }
    fn add(amount) {
        self.value = self.value + amount;
        self.updates = self.updates + 1;
        return self.value;
    }
}
let counter = new Counter();
print counter.value;
counter.init(10);
let copy = counter;
copy.add(5);
print counter.value;
print copy.value;
counter.value = 2;
while (counter.value < 4) {
    counter.add(1);
}
print counter.value;
print counter.updates;
let selected: Counter;
if (copy.value > 10) {
    selected = copy;
} else {
    selected = counter;
}
print selected.value;
