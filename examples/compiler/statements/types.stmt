fn selected(flag: bool, yes: int, no: int): int {
    let result: int;
    if (flag) {
        result = yes;
    } else {
        return no;
    }
    return result;
}

fn advance(start: int, limit: int, enabled: bool): int {
    let value: int = start;
    let done: bool = false;
    while (done == false) {
        if (enabled) {
            if (value < limit) {
                value = value + 1;
            } else {
                done = true;
            }
        } else {
            done = true;
        }
    }
    return value;
}

let empty: int;
empty = 0;
let enabled: bool = true;
print enabled;
let counter: int = advance(1, 3, enabled);
let active: bool = counter == 3;
print active;
