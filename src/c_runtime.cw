// The standalone runtime is embedded in the generator, not read at generation time.
class CParserRuntime {
    void emitTypes(String out) {
        out.append("/* Generated by cparsegen --target c. Standalone ISO C99. */\n")
        out.append("#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stddef.h>\n#include <stdint.h>\n\n")
        out.append("typedef struct { int first, last; } Range;\n")
        out.append("typedef struct { const Range *ranges; size_t count; int minimum, maximum; } Part;\n")
        out.append("typedef struct { const char *name; const Part *parts; size_t count; int skip; } ScanRule;\n")
        out.append("typedef struct { const char *text; size_t length; const char *kind; } Literal;\n")
        out.append("typedef struct { int kind; const char *value; const size_t *children; size_t count; int minimum, maximum; } Expr;\n")
        out.append("typedef struct { const char *name; size_t expression; } Rule;\n")
        out.append("typedef struct { const char *kind; size_t offset, length; } Token;\n")
        out.append("typedef struct Node Node;\n")
        out.append("struct Node { const char *name; size_t offset, length, count; Node **children; };\n")
        out.append("typedef struct { size_t end, count; Node **nodes; } Result;\n")
        out.append("typedef struct { Result *items; size_t count, capacity; } Results;\n")
        out.append("typedef struct Allocation Allocation;\n")
        out.append("struct Allocation { void *data; Allocation *next; };\n")
        out.append("typedef struct {\n    unsigned char *input; size_t length; Token *tokens; size_t token_count;\n")
        out.append("    size_t steps, error_position, allocated; Allocation *allocations;\n} Context;\n\n")
    }

    void emitProgram(String out) {
        out.append("static void fail(const char *message) { puts(message); exit(1); }\n")
        out.append("static void *allocate(Context *ctx, size_t count, size_t size) {\n")
        out.append("    const size_t limit = 64u * 1024u * 1024u;\n")
        out.append("    if (size && count > (limit - ctx->allocated) / size) fail(\"C runtime memory limit exceeded\");\n")
        out.append("    size_t bytes = count * size;\n    if (!bytes) return NULL;\n")
        out.append("    Allocation *allocation = malloc(sizeof(*allocation));\n    void *data = calloc(count, size);\n")
        out.append("    if (!allocation || !data) { free(allocation); free(data); fail(\"C runtime allocation failed\"); }\n")
        out.append("    allocation->data = data; allocation->next = ctx->allocations; ctx->allocations = allocation;\n")
        out.append("    ctx->allocated += bytes; return data;\n}\n")
        out.append("static int accepts(const Part *part, unsigned char byte) {\n")
        out.append("    for (size_t i = 0; i < part->count; ++i)\n        if (byte >= part->ranges[i].first && byte <= part->ranges[i].last) return 1;\n    return 0;\n}\n")
        out.append("static ptrdiff_t match_parts(Context *ctx, const ScanRule *rule, size_t index, size_t offset) {\n")
        out.append("    if (++ctx->steps > 100000 || index > 256) fail(\"scanner resource limit exceeded\");\n")
        out.append("    if (index == rule->count) return (ptrdiff_t)offset;\n    const Part *part = &rule->parts[index];\n    size_t end = offset;\n")
        out.append("    while (end < ctx->length && (part->maximum < 0 || end - offset < (size_t)part->maximum) && accepts(part, ctx->input[end])) ++end;\n")
        out.append("    ptrdiff_t best = -1;\n    while (end - offset >= (size_t)part->minimum) {\n")
        out.append("        ptrdiff_t found = match_parts(ctx, rule, index + 1, end);\n        if (found > best) best = found;\n        if (end == offset) break;\n        --end;\n    }\n    return best;\n}\n")
        out.append("static int scan(Context *ctx) {\n    ctx->tokens = allocate(ctx, ctx->length, sizeof(*ctx->tokens));\n    size_t at = 0;\n")
        out.append("    while (at < ctx->length) {\n        size_t best = at; const char *kind = NULL; int skip = 0;\n        ctx->steps = 0;\n")
        out.append("        for (size_t r = 0; scan_rules[r].name; ++r) {\n            ptrdiff_t end = match_parts(ctx, &scan_rules[r], 0, at);\n")
        out.append("            if (end > (ptrdiff_t)best) { best = (size_t)end; kind = scan_rules[r].name; skip = scan_rules[r].skip; }\n        }\n")
        out.append("        for (size_t i = 0; literals[i].text; ++i) {\n            const Literal *lit = &literals[i];\n")
        out.append("            if (lit->length <= ctx->length - at && at + lit->length > best && !memcmp(ctx->input + at, lit->text, lit->length)) {\n")
        out.append("                best = at + lit->length; kind = lit->kind; skip = 0;\n            }\n        }\n")
        out.append("        if (best == at) { printf(\"lex error at byte %zu\\n\", at); return 0; }\n")
        out.append("        if (!skip) { Token token = {kind, at, best - at}; ctx->tokens[ctx->token_count++] = token; }\n        at = best;\n    }\n    return 1;\n}\n")
        out.append("static void add(Context *ctx, Results *results, Result value) {\n")
        out.append("    if (results->count >= 4096) fail(\"parser result limit exceeded\");\n")
        out.append("    if (results->count == results->capacity) {\n        size_t capacity = results->capacity ? results->capacity * 2 : 4;\n")
        out.append("        Result *items = allocate(ctx, capacity, sizeof(*items));\n        if (results->count) memcpy(items, results->items, results->count * sizeof(*items));\n")
        out.append("        results->items = items; results->capacity = capacity;\n    }\n    results->items[results->count++] = value;\n}\n")
        out.append("static Result joined(Context *ctx, Result first, Result second) {\n")
        out.append("    Result result = {second.end, first.count + second.count, NULL};\n    result.nodes = allocate(ctx, result.count, sizeof(*result.nodes));\n")
        out.append("    if (first.count) memcpy(result.nodes, first.nodes, first.count * sizeof(*result.nodes));\n")
        out.append("    if (second.count) memcpy(result.nodes + first.count, second.nodes, second.count * sizeof(*result.nodes));\n    return result;\n}\n")
        out.append("static Result wrapped(Context *ctx, const char *name, size_t offset, size_t length, Result children) {\n")
        out.append("    Node *node = allocate(ctx, 1, sizeof(*node));\n    node->name = name; node->offset = offset; node->length = length;\n")
        out.append("    node->count = children.count; node->children = children.nodes;\n")
        out.append("    Result result = {children.end, 1, allocate(ctx, 1, sizeof(Node *))};\n    result.nodes[0] = node; return result;\n}\n")
        out.append("static Results match(Context *, size_t, size_t, size_t);\n")
        out.append("static Results match_rule(Context *ctx, const Rule *rule, size_t at, size_t depth) {\n")
        out.append("    Results matches = match(ctx, rule->expression, at, depth + 1), results = {0};\n")
        out.append("    for (size_t i = 0; i < matches.count; ++i)\n        add(ctx, &results, wrapped(ctx, rule->name, 0, 0, matches.items[i]));\n    return results;\n}\n")
        out.append("static Results match(Context *ctx, size_t index, size_t at, size_t depth) {\n")
        out.append("    Results results = {0}; const Expr *expr = &expressions[index];\n")
        out.append("    if (++ctx->steps > 100000 || depth > 256) fail(\"parser resource limit exceeded\");\n")
        out.append("    if (at > ctx->error_position) ctx->error_position = at;\n")
        out.append("    if (expr->kind == 0 || expr->kind == 1) {\n")
        out.append("        if (expr->kind == 0) {\n            for (size_t r = 0; rules[r].name; ++r)\n")
        out.append("                if (!strcmp(rules[r].name, expr->value)) return match_rule(ctx, &rules[r], at, depth);\n        }\n")
        out.append("        if (at < ctx->token_count && !strcmp(ctx->tokens[at].kind, expr->value)) {\n")
        out.append("            Token token = ctx->tokens[at]; Result child = {at + 1, 0, NULL};\n")
        out.append("            add(ctx, &results, wrapped(ctx, token.kind, token.offset, token.length, child));\n        }\n        return results;\n    }\n")
        out.append("    if (expr->kind == 3) {\n        for (size_t c = 0; c < expr->count; ++c) {\n")
        out.append("            Results alternatives = match(ctx, expr->children[c], at, depth);\n")
        out.append("            for (size_t a = 0; a < alternatives.count; ++a) add(ctx, &results, alternatives.items[a]);\n        }\n        return results;\n    }\n")
        out.append("    Results states = {0}; Result initial = {at, 0, NULL}; add(ctx, &states, initial);\n")
        out.append("    if (expr->kind == 2) {\n        for (size_t c = 0; c < expr->count && states.count; ++c) {\n            Results next = {0};\n")
        out.append("            for (size_t s = 0; s < states.count; ++s) {\n                Result state = states.items[s];\n")
        out.append("                Results matches = match(ctx, expr->children[c], state.end, depth);\n")
        out.append("                for (size_t m = 0; m < matches.count; ++m) add(ctx, &next, joined(ctx, state, matches.items[m]));\n            }\n            states = next;\n        }\n        return states;\n    }\n")
        out.append("    if (expr->minimum == 0) add(ctx, &results, initial);\n    size_t count = 0;\n")
        out.append("    while (states.count && (expr->maximum < 0 || count < (size_t)expr->maximum)) {\n        Results next = {0};\n")
        out.append("        for (size_t s = 0; s < states.count; ++s) {\n            Result state = states.items[s];\n")
        out.append("            Results matches = match(ctx, expr->children[0], state.end, depth);\n")
        out.append("            for (size_t m = 0; m < matches.count; ++m) {\n                Result found = matches.items[m];\n")
        out.append("                if (found.end <= state.end) fail(\"nullable repetition reached parser\");\n")
        out.append("                add(ctx, &next, joined(ctx, state, found));\n            }\n        }\n        ++count;\n")
        out.append("        if (count >= (size_t)expr->minimum)\n            for (size_t n = 0; n < next.count; ++n) add(ctx, &results, next.items[n]);\n        states = next;\n    }\n    return results;\n}\n")
        out.append("static void render(const Context *ctx, const Node *node) {\n    fputs(node->name, stdout); putchar('(');\n")
        out.append("    if (!node->count && node->length) fwrite(ctx->input + node->offset, 1, node->length, stdout);\n")
        out.append("    for (size_t i = 0; i < node->count; ++i) { if (i) fputs(\", \", stdout); render(ctx, node->children[i]); }\n    putchar(')');\n}\n")
        out.append("static int parse(Context *ctx, int complete) {\n    ctx->steps = 0;\n    Results matches = match_rule(ctx, &rules[0], 0, 0);\n    Result *best = NULL;\n")
        out.append("    for (size_t i = 0; i < matches.count; ++i) {\n        Result *found = &matches.items[i];\n")
        out.append("        if ((!complete || found->end == ctx->token_count) && (!best || found->end < best->end)) best = found;\n    }\n")
        out.append("    if (!best) { printf(\"parse error at token %zu\\n\", ctx->error_position); return 0; }\n")
        out.append("    render(ctx, best->nodes[0]); putchar('\\n'); return 1;\n}\n")
        out.append("int main(int argc, char **argv) {\n    int complete = argc == 3 && !strcmp(argv[1], \"--complete\");\n")
        out.append("    if (argc != 2 && !complete) { fputs(\"usage: parser [--complete] INPUT\\n\", stderr); return 2; }\n")
        out.append("    const char *path = argv[complete ? 2 : 1]; FILE *file = fopen(path, \"rb\");\n")
        out.append("    if (!file) { perror(path); return 1; }\n    Context ctx = {0};\n")
        out.append("    const size_t input_limit = 1024u * 1024u;\n    ctx.input = allocate(&ctx, input_limit, 1);\n")
        out.append("    ctx.length = fread(ctx.input, 1, input_limit, file);\n")
        out.append("    int extra = fgetc(file), read_error = ferror(file);\n    int close_error = fclose(file);\n")
        out.append("    int success = 0;\n")
        out.append("    if (read_error || close_error) fprintf(stderr, \"%s: input read failed\\n\", path);\n")
        out.append("    else if (extra != EOF) fputs(\"C runtime input limit exceeded\\n\", stdout);\n")
        out.append("    else success = scan(&ctx) && parse(&ctx, complete);\n")
        out.append("    while (ctx.allocations) { Allocation *next = ctx.allocations->next; free(ctx.allocations->data); free(ctx.allocations); ctx.allocations = next; }\n")
        out.append("    if (fflush(stdout) || ferror(stdout)) { fputs(\"parser: output write failed\\n\", stderr); return 1; }\n")
        out.append("    return success ? 0 : 1;\n}\n")
    }
}
