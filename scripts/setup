#!/usr/bin/env bash

set -o errexit -o nounset -o pipefail

if [[ -n "${_PROJECT_NAME:-}" ]]; then
    printf 'A project shell is already active (%s). Exit it before starting another.\n' \
        "$_PROJECT_NAME" >&2
    exit 1
fi

if (( $# > 1 )); then
    printf 'Usage: %s [debug|release|profile]\n' "$0" >&2
    exit 2
fi

build_type="${1:-}"
case "$build_type" in
    "")
        cmake_build_type=""
        ;;
    debug)
        cmake_build_type=Debug
        ;;
    release)
        cmake_build_type=Release
        ;;
    profile)
        cmake_build_type=RelWithDebInfo
        ;;
    *)
        printf 'Unknown build type: %s\nUsage: %s [debug|release|profile]\n' \
            "$build_type" "$0" >&2
        exit 2
        ;;
esac

project_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
build_dir="$project_root/build"

if [[ -z "${CWHIP_SDK:-}" ]]; then
    if ! cwhip_sdk_prefix="$(python3 "$project_root/scripts/sdk-prefix.py" --discover)"; then
        printf 'Cwhip SDK discovery failed; project shell was not started.\n' >&2
        exit 1
    fi
    if [[ -n "$cwhip_sdk_prefix" ]]; then
        export CWHIP_SDK="$cwhip_sdk_prefix"
    fi
fi

export _PROJECT_LOC="$project_root"
export _PROJECT_NAME="$(basename -- "$project_root")"

cmake_args=()
if [[ -n "$cmake_build_type" ]]; then
    cmake_args+=("-DCMAKE_BUILD_TYPE=$cmake_build_type")
fi
if ! cmake -S "$project_root" -B "$build_dir" "${cmake_args[@]}"; then
    printf 'CMake configuration failed; project shell was not started.\n' >&2
    exit 1
fi

cmake_build_type="$(sed -n 's/^CMAKE_BUILD_TYPE:[^=]*=//p' "$build_dir/CMakeCache.txt" | head -n 1)"
case "$cmake_build_type" in
    Debug)
        build_type=debug
        ;;
    Release)
        build_type=release
        ;;
    RelWithDebInfo)
        build_type=profile
        ;;
    "")
        build_type=default
        ;;
    *)
        build_type="${cmake_build_type,,}"
        ;;
esac
export _BUILD_TYPE="$build_type"
export CWHIP_BUILD_TYPE="$cmake_build_type"

bash --rcfile "$project_root/.project_env" -i
